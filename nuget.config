<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    EPOCH V1 builds offline and package-free by design: the deterministic Core and
    its tests take no third-party dependency. Sources are cleared so that an
    accidental PackageReference fails loudly at restore instead of silently
    pulling a dependency into the authoritative simulation.
    Unity-side packages are managed by Unity's own package manager, not NuGet.
  -->
  <packageSources>
    <clear />
  </packageSources>
</configuration>
